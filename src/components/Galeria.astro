---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import conteudo from '../data/conteudo.json';

const modulos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/galeria/*.{jpg,jpeg,png}',
  { eager: true }
);

const imagens = Object.keys(modulos)
  .sort()
  .map((caminho) => modulos[caminho].default)
  .filter(Boolean);
---

{imagens.length > 0 && (
  <section class="gal" id="trabalhos">
    <div class="gal__int">
      <header class="gal__topo">
        <p class="gal__kicker">{conteudo.galeria.kicker}</p>
        <h2>{conteudo.galeria.titulo}</h2>
        <p class="gal__nota">{conteudo.galeria.nota}</p>
      </header>

      <ul class="gal__grelha">
        {imagens.map((img, i) => (
          <li class="gal__item">
            <Image
              src={img}
              alt={conteudo.galeria.legendas[i] ?? conteudo.galeria.legendaFallback}
              widths={[350, 600]}
              sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
              format="webp"
              quality={72}
              loading="lazy"
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .gal {
    background: var(--fundo-alt);
    padding-block: var(--e-xl);
  }

.gal__int {
  max-width: var(--largura-max);
  margin-inline: auto;
  padding-inline: var(--e-sm);
}

  .gal__topo {
    text-align: center;
    max-width: 48ch;
    margin-inline: auto;
    margin-bottom: var(--e-lg);
  }

  .gal__kicker {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--acento);
    margin: 0 0 var(--e-xs);
  }

  .gal h2 {
    font-size: var(--t-h2);
    margin: 0 0 var(--e-sm);
  }

  .gal__nota {
    font-size: var(--t-peq);
    color: var(--texto-suave);
    margin: 0;
  }

  .gal__grelha {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--e-xs);
  }

  .gal__item {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--borda);
  }

  .gal__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .gal__item:hover :global(img) {
    transform: scale(1.04);
  }

  @media (min-width: 600px) {
    .gal__grelha { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 900px) {
    .gal__grelha {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e-sm);
    }
  }
</style>