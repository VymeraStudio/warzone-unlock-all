---
import BotaoMarcar from './BotaoMarcar.astro';
---

<div class="barra">
  <BotaoMarcar classe="barra__btn" />
</div>

<style>
  .barra {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: 0.6rem var(--e-sm) calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(247, 242, 236, 0.95);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--borda);
  }
  .barra__btn { width: 100%; }

  @media (min-width: 900px) { .barra { display: none; } }
</style>